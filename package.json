{
  "name": "memo-app",
  "version": "1.2.1",
  "description": "Windows 会议纪要应用 / Meeting Minutes App — 捕获系统音频和麦克风，实时转写，AI 生成结构化纪要 / Capture system audio & mic, real-time transcription, AI-generated structured minutes",
  "main": "dist-electron/main.js",
  "author": "Memo Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint src/ electron/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "precommit": "npm run lint && npm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^6.26.0",
    "wavesurfer.js": "^7.8.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "happy-dom": "^15.0.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.8"
